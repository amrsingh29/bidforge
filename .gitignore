deals/

# Local settings
*.local.json

# Python
.venv/
__pycache__/

# Test-set definitions point at real customer files: local only
tests/set/

# A product pack with your employer's or a customer's catalogue must never be published. It belongs in
# ~/.bidforge/local-packs/ (outside this repo), which outranks this folder anyway. Kept here as a
# second lock, for the case where somebody drops a real catalogue straight into packs/ by habit.
packs/products/bmc-helix/
packs/local/
